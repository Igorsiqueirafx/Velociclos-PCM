# Backend Environment Variables
# Copy to .env and fill with your values

# Server
PORT=3001
ADMIN_PASSWORD=your-secret-password-here
FRONTEND_URL=https://velociclos.com.br
CORS_ORIGIN=https://velociclos.com.br

# YouTube API (for playlist sync endpoints)
YOUTUBE_API_KEY=your-youtube-api-key-here
NEXT_PUBLIC_YOUTUBE_API_KEY=your-youtube-api-key-here

# Playlist IDs to sync (comma-separated)
PLAYLIST_IDS=PLWhqc48nlRWLhDr-YqQhwVGhCFwUCcw7I,PLWhqc48nlRWIBLg85_VDOcqRAq-BWi-J9

# Supabase (if used for auth integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Deployment
BACKEND_URL=https://your-backend-url.com
DATA_DIR=.
