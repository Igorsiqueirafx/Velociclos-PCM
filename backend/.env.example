# Backend Environment Variables
# Copy to .env and fill with your values

# Server
PORT=3001

# CORS (allow frontend domain(s) - comma separated for multiple origins)
FRONTEND_URL=https://velociclos.vercel.app
CORS_ORIGIN=https://velociclos.vercel.app

# YouTube API (for playlist sync endpoints)
YOUTUBE_API_KEY=your-youtube-api-key-here

# Playlist IDs to sync (comma-separated)
PLAYLIST_IDS=PLWhqc48nlRWLhDr-YqQhwVGhCFwUCcw7I,PLWhqc48nlRWIBLg85_VDOcqRAq-BWi-J9,PLWhqc48nlRWKnmtTenj21hAdK3Lasx-Yh,PLWhqc48nlRWJKFtMeqiQjWAtGRitoYSFK,PLWhqc48nlRWKWGyAfGr0iLpwtsGexhnaZ,PLWhqc48nlRWLahmd1buhzix23XcAFJkqD,PLWhqc48nlRWL8F5Tl7UtqY2S4SXlYG6B5,PLWhqc48nlRWLJ-8YQA16dpId_6L1w4ySKV,PLWhqc48nlRWKWGyAfGr0iLpwtsGexhnaZ,PLWhqc48nlRWLahmd1buhzix23XcAFJkqD,PLWhqc48nlRWL8F5Tl7UtqY2S4SXlYG6B5,PLWhqc48nlRWLJ-8YQA16dpId_6L1w4ySKV,PLWhqc48nlRWJpjKnjSaJpq4jMRE_ukg6V,PLWhqc48nlRWJZyYdEi3gcSIHx6cy0Hxlb,PLWhqc48nlRWITJy0wfqGdXprKLkEecXIv,PLWhqc48nlRWLqE-RBi_RTBjKit-xFWeOC,PLWhqc48nlRWLKu17t5xqL6Sr3T6Pwn1DcL,PLWhqc48nlRWIKhZTuRMMy4vtOhN_HANlw,PLWhqc48nlRWIuwZkiaLAfDfFKWWndWUxO

# Database
# In-memory mode for local development (no external database required)
USE_IN_MEMORY=true

# Supabase (production database)
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional: if using service_role key for admin operations
SUPABASE_SECRET_KEY=your-service-role-key

# Deployment
BACKEND_URL=https://velociclos-api.vercel.app
DATA_DIR=.
