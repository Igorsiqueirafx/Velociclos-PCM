# Backend Environment Variables
# Copy to .env and fill with your values

# Server
PORT=3001
ADMIN_PASSWORD=change-this-to-a-secure-password

# CORS (allow frontend domain(s))
FRONTEND_URL=https://velociclos-pcm-frontend.vercel.app
CORS_ORIGIN=https://velociclos-pcm-frontend.vercel.app

# YouTube API (for playlist sync endpoints)
YOUTUBE_API_KEY=your-youtube-api-key-here

# Playlist IDs to sync (comma-separated)
PLAYLIST_IDS=PLWhqc48nlRWLhDr-YqQhwVGhCFwUCcw7I,PLWhqc48nlRWIBLg85_VDOcqRAq-BWi-J9,PLWhqc48nlRWKnmtTenj21hAdK3Lasx-Yh,PLWhqc48nlRWJKFtMeqiQjWAtGRitoYSFK,PLWhqc48nlRWKWGyAfGr0iLpwtsGexhnaZ,PLWhqc48nlRWLahmd1buhzix23XcAFJkqD,PLWhqc48nlRWL8F5Tl7UtqY2S4SXlYG6B5,PLWhqc48nlRWJ-8YQA16dpId_6L1w4ySKV

# Supabase (if used for auth integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Deployment
BACKEND_URL=https://your-backend.railway.app
DATA_DIR=.
