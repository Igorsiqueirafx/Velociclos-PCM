# Frontend Environment Variables (Next.js)
# Copy to frontend/.env.local for local development
# Set these in Vercel Dashboard → Settings → Environment Variables for production

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend API (Express on Railway) — optional, frontend falls back to direct YouTube API
NEXT_PUBLIC_BACKEND_URL=https://velociclos-api.up.railway.app

# Admin password (server-side only, not exposed to client)
ADMIN_PASSWORD=velociclos2024

# YouTube API key — used as fallback when backend is unavailable
# The cursos page fetches playlists directly from YouTube Data API v3
# when the backend /api/playlists endpoint is down.
# Get one from: https://console.cloud.google.com/apis/library/youtube.googleapis.com
NEXT_PUBLIC_YOUTUBE_API_KEY=

# Admin emails (comma-separated) — users with these emails can access /dashboard
# Non-admin users will be redirected to /unauthorized
ADMIN_EMAILS=