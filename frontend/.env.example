# Frontend Environment Variables (Next.js)
# Copy to frontend/.env.local and fill with your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend API (Express on Railway)
NEXT_PUBLIC_BACKEND_URL=https://velociclos-api.up.railway.app

# YouTube API key — ONLY needed in backend, NOT in frontend
# The frontend fetches playlists from backend /api/playlists (which uses this key)
# NEXT_PUBLIC_YOUTUBE_API_KEY=not-needed-frontend

# Email service (Brevo/Sendinblue) — uncomment when integrated for welcome emails
# BREVO_API_KEY=
# BREVO_WELCOME_TEMPLATE_ID=
