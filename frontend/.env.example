# Frontend Environment Variables (Next.js)
# Copy to frontend/.env.local for local development
# Set these in Vercel Dashboard → Settings → Environment Variables for production

# GitHub OAuth (for authentication via NextAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NextAuth
AUTH_SECRET=
# Generate with: openssl rand -base64 32

# Backend API
NEXT_PUBLIC_BACKEND_URL=https://seu-backend.vercel.app

# Admin password (server-side only, not exposed to client)
ADMIN_PASSWORD=

# YouTube API key — used by backend for playlist sync
YOUTUBE_API_KEY=

# Admin emails (comma-separated) — users with these emails can access /dashboard
ADMIN_EMAILS=

# Email Marketing (Brevo/Sendinblue)
# Get API key from: https://app.brevo.com/account/api
BREVO_API_KEY=